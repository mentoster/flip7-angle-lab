<?xml version="1.0" encoding="utf-8"?>
<!-- Calibration samples and device telemetry must never be backed up. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
